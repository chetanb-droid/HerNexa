---
import Layout from '../../layouts/Layout.astro';
import PageComponent from '../../react-pages/Category.tsx';

export function getStaticPaths() {
  return [
    { params: { slug: 'pregnancy' } },
    { params: { slug: 'ovulation' } },
    { params: { slug: 'period' } },
    { params: { slug: 'nutrition' } },
    { params: { slug: 'postpartum' } },
    { params: { slug: 'health-risk' } },
  ];
}
const { slug } = Astro.params;
---

<Layout>
  <PageComponent slug={slug} client:load />
</Layout>
